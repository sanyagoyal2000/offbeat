# Qloo Insights API (server-side only). Use the base URL from the hackathon developer guide.
QLOO_API_KEY=
QLOO_API_URL=https://hackathon.api.qloo.com
# Optional: stay under the account limits (hackathon key: 5 req/s, 10,000/month).
QLOO_RPS=4
QLOO_MONTHLY_BUDGET=8000

# Promotional copy drafting. Default: Anthropic API if ANTHROPIC_API_KEY is set; otherwise, locally,
# the Claude Code CLI (`claude`) as a fallback; hosted builds without a key use built-in templates.
# Set LLM_PROVIDER=none to force templates.
LLM_PROVIDER=
ANTHROPIC_API_KEY=

# Required: the Turso (libSQL) database. See README → Database.
# URL looks like libsql://<db-name>-<org>.turso.io; the token from `turso db tokens create <db-name>`.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
